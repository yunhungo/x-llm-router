# Runtime
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://xrouter:xrouter@localhost:5432/xrouter
POSTGRES_DB=xrouter
POSTGRES_USER=xrouter
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_PORT=5432

# Required in production. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-another-long-random-secret

# Initial administrator. Only used when the users table is empty.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-now

# Optional upstream overrides (useful for tests/private relays).
OPENAI_API_BASE=https://api.openai.com/v1
CHATGPT_API_BASE=https://chatgpt.com/backend-api/codex
CHATGPT_AUTH_BASE=https://auth.openai.com
