# Local/direct runtime only. docker-compose.release.yml does not require this file.
# Runtime
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://xrouter:xrouter@localhost:5432/xrouter
POSTGRES_DB=xrouter
POSTGRES_USER=xrouter
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_PORT=5432

# Initial administrator. Only used when the users table is empty.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-now

# Optional endpoint overrides for direct/local runs.
OPENAI_API_BASE=https://api.openai.com/v1
CHATGPT_API_BASE=https://chatgpt.com/backend-api/codex
CHATGPT_AUTH_BASE=https://auth.openai.com
OPENAI_CODEX_CLIENT_VERSION=0.147.0
LANGFUSE_DIAGNOSTICS=0

# Optional outbound proxy for the app container. The proxy address must be
# reachable from inside Docker; 127.0.0.1 points to the container itself.
XROUTER_HTTP_PROXY=
XROUTER_HTTPS_PROXY=
# This is the complete NO_PROXY value, not an appended suffix. Keep these defaults.
XROUTER_NO_PROXY=localhost,127.0.0.1,db
